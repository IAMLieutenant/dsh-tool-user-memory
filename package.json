{
  "name": "dsh-tool-user-memory",
  "version": "0.2.0",
  "description": "User preference memory for DeepSeek Harness: persisted user profile with memory_get/memory_update tools and system-prompt injection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "IAMLieutenant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAMLieutenant/dsh-tool-user-memory.git"
  },
  "homepage": "https://github.com/IAMLieutenant/dsh-tool-user-memory#readme",
  "bugs": {
    "url": "https://github.com/IAMLieutenant/dsh-tool-user-memory/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "memory",
    "user-profile",
    "preferences"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node tests/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.3 <5.0.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.3 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/cosmokit": "1.8.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.7-alpha.1",
