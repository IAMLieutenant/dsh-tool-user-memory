    "@deepseek-ai/dsh-util-values": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "zod": "4.6.5"
